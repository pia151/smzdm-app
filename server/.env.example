# ============================================
# 值否 - 平台 API 接入配置
# ============================================
PORT=3001
JWT_SECRET=填写你的JWT密钥

# ---- 京东联盟 API (https://union.jd.com) ----
# 需要在京东联盟开放平台创建应用
# 应用 -> 创建应用 -> 获取 AppKey 和 SecretKey
JD_APP_KEY=你的京东联盟AppKey
JD_APP_SECRET=你的京东联盟SecretKey

# ---- 淘宝/天猫 API (https://tbk.taobao.com) ----
# 需要在淘宝联盟（阿里妈妈）开通淘宝客权限
# 我的工具 -> 身份认证 -> API接入 -> 获取 AppKey/AppSecret
# 注意: 需要企业实名认证
TB_APP_KEY=你的淘宝客AppKey
TB_APP_SECRET=你的淘宝客AppSecret
TB_ADZONE_ID=你的推广位ID

# ---- 拼多多 API (https://open.pinduoduo.com) ----
# 需要在拼多多开放平台注册应用
# 开放平台 -> 创建应用 -> 获取 ClientId/ClientSecret
# 需要企业认证
PDD_CLIENT_ID=你的拼多多开放平台ClientId
PDD_CLIENT_SECRET=你的拼多多开放平台ClientSecret
PDD_PID=你的推广位ID

# ---- 什么值得买爬虫 ----
# 不需要 API 密钥，仅用于站外同步
# 可选: 设置代理IP池（防封）
PROXY_URL=

# ---- 可选：1688/天猫超市 ----
# 暂无官方 API，走爬虫方案